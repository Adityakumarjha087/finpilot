# ---------------------------------------------------------------------------
# FinPilot environment. Copy to .env and replace every "change-me" value.
#   cp .env.example .env
# Generate secrets with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me-db-password
# Login role used ONLY by the text-to-SQL assistant (SELECT on nl_* views)
DB_READONLY_USER=finpilot_readonly
DB_READONLY_PASSWORD=change-me-readonly-password

# --- Security ------------------------------------------------------------------
# HS256 signing key for access tokens (>= 32 bytes)
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D
# AES-256-GCM key for encrypted columns: base64 of exactly 32 bytes (openssl rand -base64 32)
FINPILOT_ENCRYPTION_KEY=change-me-base64-32-byte-key
# Shared secret between backend and ML service (X-Internal-Token header)
ML_SERVICE_TOKEN=change-me-internal-token
CORS_ALLOWED_ORIGINS=http://localhost:20800
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=300

# --- LLM provider (text-to-SQL + savings advice) --------------------------------
# fake (default, offline, deterministic) | anthropic | openai | gemini | ollama
LLM_PROVIDER=fake
# Model id; defaults: anthropic=claude-opus-5-5, openai=gpt-4o-mini, gemini=gemini-2.0-flash, ollama=llama3.1
LLM_MODEL=
# API key for anthropic / openai / gemini (not needed for fake or ollama)
LLM_API_KEY=
# Optional base URL override (e.g. http://host.docker.internal:11434 for Ollama)
LLM_BASE_URL=

# --- App ----------------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
SEED_DEMO_DATA=true
RETRAIN_MIN_CORRECTIONS=5
RETRAIN_CRON=0 */15 * * * *
LOG_FORMAT=ecs
